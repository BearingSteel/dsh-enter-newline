{
  "name": "dsh-enter-newline",
  "version": "1.0.0",
  "private": true,
  "description": "Enter inserts a newline and Shift+Enter sends the message.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "assets/icon-180.png"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearingSteel/dsh-enter-newline.git"
  },
  "homepage": "https://github.com/BearingSteel/dsh-enter-newline#readme",
  "bugs": {
    "url": "https://github.com/BearingSteel/dsh-enter-newline/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "keyboard"
  ]
}
